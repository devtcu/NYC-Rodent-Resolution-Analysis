{
  "datasets": [
    {
      "name": "final_tables",
      "displayName": "NYC Rodent Final Tables",
      "queryLines": [
        "WITH raw AS (\n",
        "  SELECT\n",
        "    *\n",
        "  FROM\n",
        "    read_files(\n",
        "      '/Workspace/Shared/rat_investigation/Final_Tables/',\n",
        "      format => 'csv',\n",
        "      header => true,\n",
        "      schemaEvolutionMode => 'none',\n",
        "      pathGlobFilter => 'Final.csv'\n",
        "    )\n",
        "),\n",
        "zip_coords AS (\n",
        "  SELECT\n",
        "    TRY_CAST(zip_code AS INT) AS zipcode,\n",
        "    AVG(latitude) AS avg_lat,\n",
        "    AVG(longitude) AS avg_lng\n",
        "  FROM\n",
        "    workspace.default.rat_sightings_normalized\n",
        "  GROUP BY\n",
        "    TRY_CAST(zip_code AS INT)\n",
        ")\n",
        "SELECT\n",
        "  TRY_CAST(r.zipcode AS INT) AS zipcode,\n",
        "  TRY_CAST(total_rat_sightings AS DOUBLE) AS total_rat_sightings,\n",
        "  TRY_CAST(mature_rat_sightings AS DOUBLE) AS mature_rat_sightings,\n",
        "  TRY_CAST(closed_rat_sightings AS DOUBLE) AS closed_rat_sightings,\n",
        "  TRY_CAST(median_resolution_days AS DOUBLE) AS median_resolution_days,\n",
        "  TRY_CAST(average_resolution_days AS DOUBLE) AS average_resolution_days,\n",
        "  TRY_CAST(avg_p90_resolution_days AS DOUBLE) AS avg_p90_resolution_days,\n",
        "  TRY_CAST(resolved_within_30_days AS DOUBLE) AS resolved_within_30_days,\n",
        "  TRY_CAST(not_resolved_within_30_days AS DOUBLE) AS not_resolved_within_30_days,\n",
        "  TRY_CAST(avg_percent_unresolved_within_30_days AS DOUBLE) AS avg_percent_unresolved_within_30_days,\n",
        "  TRY_CAST(represented_inspections AS DOUBLE) AS represented_inspections,\n",
        "  TRY_CAST(inspected_restaurants AS DOUBLE) AS inspected_restaurants,\n",
        "  TRY_CAST(inspections_with_04k AS DOUBLE) AS inspections_with_04k,\n",
        "  TRY_CAST(percent_inspections_with_04k AS DOUBLE) AS percent_inspections_with_04k,\n",
        "  TRY_CAST(complaint_percentile AS DOUBLE) AS complaint_percentile,\n",
        "  TRY_CAST(inspection_evidence_percentile AS DOUBLE) AS inspection_evidence_percentile,\n",
        "  TRY_CAST(potential_underreporting_score AS DOUBLE) AS potential_underreporting_score,\n",
        "  CASE\n",
        "    WHEN interpretation IS NOT NULL THEN interpretation\n",
        "    WHEN\n",
        "      potential_underreporting_score IS NOT NULL\n",
        "      AND TRY_CAST(potential_underreporting_score AS DOUBLE) IS NULL\n",
        "    THEN\n",
        "      potential_underreporting_score\n",
        "    ELSE NULL\n",
        "  END AS interpretation,\n",
        "  zc.avg_lat,\n",
        "  zc.avg_lng\n",
        "FROM\n",
        "  raw r\n",
        "LEFT JOIN zip_coords zc ON TRY_CAST(r.zipcode AS INT) = zc.zipcode"
      ]
    },
    {
      "name": "final_coords",
      "displayName": "Final Tables with Coordinates",
      "queryLines": [
        "WITH raw AS (\n",
        "  SELECT\n",
        "    *\n",
        "  FROM\n",
        "    read_files(\n",
        "      '/Workspace/Shared/rat_investigation/Final_Tables/',\n",
        "      format => 'csv',\n",
        "      header => true,\n",
        "      schemaEvolutionMode => 'none',\n",
        "      pathGlobFilter => 'Final.csv'\n",
        "    )\n",
        "),\n",
        "zip_coords AS (\n",
        "  SELECT\n",
        "    TRY_CAST(zip_code AS INT) AS zipcode,\n",
        "    AVG(latitude) AS avg_lat,\n",
        "    AVG(longitude) AS avg_lng\n",
        "  FROM\n",
        "    workspace.default.rat_sightings_normalized\n",
        "  GROUP BY\n",
        "    TRY_CAST(zip_code AS INT)\n",
        ")\n",
        "SELECT\n",
        "  TRY_CAST(r.zipcode AS INT) AS zipcode,\n",
        "  TRY_CAST(r.avg_percent_unresolved_within_30_days AS DOUBLE) AS avg_pct_unresolved,\n",
        "  TRY_CAST(r.potential_underreporting_score AS DOUBLE) AS underreporting_score,\n",
        "  ABS(TRY_CAST(r.potential_underreporting_score AS DOUBLE)) AS severity_score,\n",
        "  CASE\n",
        "    WHEN r.interpretation IS NOT NULL THEN r.interpretation\n",
        "    ELSE NULL\n",
        "  END AS interpretation,\n",
        "  zc.avg_lat,\n",
        "  zc.avg_lng\n",
        "FROM\n",
        "  raw r\n",
        "    LEFT JOIN zip_coords zc\n",
        "      ON TRY_CAST(r.zipcode AS INT) = zc.zipcode"
      ]
    }
  ],
